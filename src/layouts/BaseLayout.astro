---
import "../styles/global.css";
import type { SiteContent } from "../data/types";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  meta: SiteContent["meta"];
  footer: SiteContent["footer"];
}

const { meta, footer } = Astro.props;

// The mark from the wordmark, on its own: the same two paths BrandLogo draws,
// cropped to the 80x80 the tile occupies in that file's 320x100 box. Taking the
// geometry rather than redrawing it means the two cannot drift apart.
//
// Quotes stay percent-encoded (%22): written literally they come out as
// &quot; in the attribute, which is a data URI the spec doesn't guarantee.
const favicon =
  "data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220.333 9.669 80 80%22><path d=%22M63.3569 9.66895C64.2632 9.66895 64.7171 9.66914 65.1001 9.6875C73.3337 10.0826 79.9198 16.6687 80.3149 24.9023C80.3333 25.2853 80.3335 25.7392 80.3335 26.6455V49.6689C80.3335 71.7602 62.4247 89.6688 40.3335 89.6689H17.3101C16.4038 89.6689 15.9499 89.6687 15.5669 89.6504C7.33328 89.2553 0.747159 82.6692 0.352051 74.4355C0.333694 74.0526 0.333496 73.5987 0.333496 72.6924V49.6689C0.333497 27.5777 18.2423 9.66912 40.3335 9.66895H63.3569Z%22 fill=%22%231A1A1A%22/><path d=%22M40.5 24.416C42.1566 24.4163 43.5 25.7603 43.5 27.417V42.2578L53.9941 31.7637C55.1657 30.5921 57.0657 30.5921 58.2373 31.7637C59.4082 32.9353 59.4087 34.8355 58.2373 36.0068L47.7441 46.5H62.584C64.2404 46.5004 65.5838 47.8436 65.584 49.5C65.5837 51.1564 64.2403 52.4996 62.584 52.5H47.7432L58.2373 62.9941C59.4083 64.1658 59.4087 66.0659 58.2373 67.2373C57.0659 68.4087 55.1658 68.4083 53.9941 67.2373L43.5 56.7432V71.584C43.4996 73.2403 42.1564 74.5837 40.5 74.584C38.8436 74.5838 37.5004 73.2404 37.5 71.584V56.7441L27.0068 67.2373C25.8355 68.4087 23.9353 68.4082 22.7637 67.2373C21.5921 66.0657 21.5921 64.1657 22.7637 62.9941L33.2578 52.5H18.417C16.7603 52.5 15.4163 51.1566 15.416 49.5C15.4162 47.8433 16.7602 46.5 18.417 46.5H33.2568L22.7637 36.0068C21.5921 34.8353 21.5921 32.9352 22.7637 31.7637C23.9352 30.5921 25.8353 30.5921 27.0068 31.7637L37.5 42.2568V27.417C37.5 25.7602 38.8433 24.4162 40.5 24.416Z%22 fill=%22white%22/></svg>";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href={favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Lora:ital,wght@0,500;0,600;0,700;1,500;1,600;1,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <SiteHeader />

    <main id="main">
      <slot />
    </main>

    <SiteFooter footer={footer} />

    <script>
      import "../scripts/main.js";
    </script>
    <script>
      import "../scripts/gradient-bg.js";
    </script>
    <script>
      import "../scripts/header-theme.js";
    </script>
    <script>
      import "../scripts/nav-pill.js";
    </script>
    <script>
      import "../scripts/about-video.js";
    </script>
    <script>
      import "../scripts/reveal.js";
    </script>
  </body>
</html>
