---
// Version 1 — mirrors the original index.html.
// Sections are listed here rather than in a shared page component so the two
// versions can diverge in structure, not just in copy.
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Team from "../components/Team.astro";
import Services from "../components/Services.astro";
import Stages from "../components/Stages.astro";
// Testimonials are off the page for now. The component, its content and
// its CSS stay where they are, so the section comes back by restoring
// this import and the line below Services.
import Work from "../components/Work.astro";
import Cta from "../components/Cta.astro";
import Faq from "../components/Faq.astro";
import Contact from "../components/Contact.astro";
import { v1 as content } from "../data/v1";
---

<BaseLayout meta={content.meta} footer={content.footer}>
  {/* The hero and the team read as one dark field rather than two cards with
      a seam between them, so they share a background: the band carries it and
      both of them sit on it transparent. */}
  <div class="intro-band">
    <Hero hero={content.hero} />
    <Team team={content.team} />
  </div>
  {/* The industries and the stages read as one field: who we design for, then
      who we help. The dot texture belongs to the pair, so the band carries it
      and both sections sit on it transparent. */}
  <div class="field-band">
    <About industries={content.industries} />
    {/* The seam. It lives inside the same wrap as the columns, so it takes the
        page gutter instead of restating it, and can be masked at its ends —
        a border on the section itself always runs the full bleed. */}
    <div class="wrap wrap-gutter-80 band-seam" aria-hidden="true"><span></span></div>
    <Stages stages={content.stages} />
  </div>
  <Services services={content.services} />
  <Work work={content.work} />
  <Cta cta={content.cta} />
  <Faq faq={content.faq} />
  <Contact contact={content.contact} />
</BaseLayout>
