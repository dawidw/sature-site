---
import type { SiteContent } from "../data/types";
import BrandLogo from "./BrandLogo.astro";

interface Props {
  footer: SiteContent["footer"];
}

const { footer } = Astro.props;

// Two columns sit on a tighter grid than three.
const navClass =
  footer.columns.length === 2 ? "footer-nav footer-nav-compact" : "footer-nav";

const SOCIAL_PATHS = {
  linkedin:
    "M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5zM3 8.98h4v12.02H3V8.98zM9 8.98h3.83v1.64h.05c.53-1 1.84-2.06 3.79-2.06 4.05 0 4.8 2.67 4.8 6.14v6.3h-4v-5.59c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.69H9V8.98z",
  x: "M3 3l7.5 9.5L3.4 21H6l5.8-6.6L16.5 21H21l-7.9-9.9L20.6 3H18l-5.3 6.1L8.4 3H3z",
};
---

<footer class="footer-wrap wrap">
  <div class="site-footer footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <BrandLogo />
        {footer.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        <div class="social-links">
          {
            footer.socials.map((social) => (
              <a href={social.href} aria-label={social.label}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d={SOCIAL_PATHS[social.icon]} fill="currentColor" />
                </svg>
              </a>
            ))
          }
        </div>
      </div>

      <nav class={navClass} aria-label="Footer">
        {
          footer.columns.map((column) => (
            <div class="footer-col">
              {column.map((link) => (
                <a href={link.href}>{link.label}</a>
              ))}
            </div>
          ))
        }
      </nav>
    </div>

    <div class="footer-bottom">
      <p><span id="year"></span> {footer.copyright}</p>
      <a href={footer.legal.href}>{footer.legal.label}</a>
    </div>
  </div>
</footer>
