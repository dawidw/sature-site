---
import type { SiteContent } from "../data/types";

interface Props {
  industries: SiteContent["industries"];
}

const { industries } = Astro.props;
---

{/* Carries id="about": the claim that used to open this section is gone,
    but the header nav and the footer both link here. */}
<section class="section section-industries" id="about">
  <div class="wrap wrap-gutter-80">
    <div class="about-grid">
      <div class="about-copy">
        <p>{industries.lead}</p>
      </div>
      {/* Two columns held by the grid alone. The names are not links and the
          set is not ordered, so there is nothing to draw between them. */}
      <div class="industry-field">
        <ul class="industry-list" aria-label="Industries">
          {industries.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>
