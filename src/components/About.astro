---
import type { SiteContent } from "../data/types";
import { asset } from "../lib/asset";

interface Props {
  about: SiteContent["about"];
  industries: SiteContent["industries"];
}

const { about, industries } = Astro.props;
---

<section class="section" id="about">
  {/* wrap-gutter-80 so the framed claim lands on the same vertical as the
      header, the industries row, the contact block and the footer. On the
      plain wrap it sat on the centred layout width instead, 18px further out
      at 1440 — invisible on its own, obvious once the frame drew the edge. */}
  <div class="wrap wrap-gutter-80">
    <div class="headline-frame">
      <p class="eyebrow-serif center">{about.eyebrow}</p>
      <h2 class="section-title display center">{about.title}</h2>
    </div>
  </div>
</section>

<section class="section section-industries">
  <div class="wrap wrap-gutter-80">
    <div class="about-grid">
      <div class="about-copy">
        <p>{industries.lead}</p>
        <ul class="tag-list" aria-label="Industries">
          {industries.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      </div>
      {/* Decorative, and silent — the file carries no audio track. Nothing is
          autoplayed from the markup: about-video.js starts it only once the
          slot is near the viewport and only when motion is welcome, so the
          2.3MB never loads for a reader who does not get this far. */}
      <div class="about-visual" aria-hidden="true">
        <video
          class="about-video"
          poster={asset("/assets/video/office-portrait-poster.webp")}
          preload="none"
          muted
          loop
          playsinline
        >
          <source src={asset("/assets/video/office-portrait.mp4")} type="video/mp4" />
        </video>
      </div>
    </div>
  </div>
</section>
