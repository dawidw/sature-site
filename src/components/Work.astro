---
import type { SiteContent } from "../data/types";
import { asset } from "../lib/asset";

interface Props {
  work: SiteContent["work"];
}

const { work } = Astro.props;
---

<section class="section" id="work">
  <div class="wrap wrap-gutter-80">
    <div class="work-header">
      <h2 class="section-title">{work.title}</h2>
      <button class="carousel-hint" id="work-next" type="button" aria-label="Show next work example">
        <span>{work.hint}</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="12" r="10.25" stroke="currentColor" stroke-width="1.2"></circle>
          <path
            d="M10 8.5L14 12L10 15.5"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>
    {
      work.caption && (
        <div class="work-caption">
          <p class="work-caption-title">{work.caption.title}</p>
          <p class="work-caption-body">{work.caption.body}</p>
        </div>
      )
    }
  </div>

  <div class="work-carousel-viewport">
    <ul class="work-carousel" id="work-carousel">
      {
        work.images.map((image) => (
          <li class="work-card">
            <img src={asset(image.src)} alt={image.alt} loading="lazy" />
          </li>
        ))
      }
    </ul>
  </div>
</section>
