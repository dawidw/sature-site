---
import type { SiteContent } from "../data/types";

interface Props {
  stages: SiteContent["stages"];
}

const { stages } = Astro.props;
---

<section class="section stages" id="stages">
  <div class="wrap wrap-gutter-80">
    {/* Opens the section in the same voice as the industries lead above it. */}
    <p class="stages-lead">{stages.lead}</p>
    <ul class="stage-list">
      {
        stages.items.map((stage) => (
          <li class="stage">
            <div class="stage-copy">
              <div class="stage-head">
                <p class="stage-eyebrow">{stage.eyebrow}</p>
                <h3 class="stage-title">{stage.title}</h3>
              </div>
              <p class="stage-body">{stage.body}</p>
            </div>
            {/* The same list the industries use: labels, not sentences. */}
            <ul class="stage-points">
              {stage.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>
