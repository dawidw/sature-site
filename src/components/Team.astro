---
import type { SiteContent } from "../data/types";
import RichText from "./RichText.astro";

interface Props {
  team: SiteContent["team"];
}

const { team } = Astro.props;
---

<section class="team-wrap wrap">
  <div class="section-dark">
    <p class="section-title center on-dark"><RichText text={team.title} /></p>

    <figure class="founders">
      <img src={team.photo.src} alt={team.photo.alt} width="1015" height="556" loading="lazy" />
      <figcaption class="founders-names">
        {team.photo.names.map((name) => <span>{name}</span>)}
      </figcaption>
    </figure>

    {/* The narrow-screen counterpart to the composite above; CSS shows one or
        the other. Both are lazy, and the hidden one is never in the viewport,
        so only the set actually on screen is fetched. */}
    <ul class="founders-stack">
      {
        team.photo.portraits.map((portrait) => (
          <li>
            <figure>
              <img src={portrait.src} alt={portrait.alt} width="732" height="908" loading="lazy" />
              <figcaption>{portrait.name}</figcaption>
            </figure>
          </li>
        ))
      }
    </ul>

    <div class="story-grid">
      <div class="story-copy">
        <h3>{team.story.heading}</h3>
        <p>{team.story.body}</p>
      </div>
      <dl class="stats">
        {
          team.stats.map((stat) => (
            <div class="stat">
              <dt>{stat.value}</dt>
              <dd>{stat.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
