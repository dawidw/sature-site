---
import type { SiteContent } from "../data/types";
import { TEAM } from "../data/types";
import RichText from "./RichText.astro";

interface Props {
  team: SiteContent["team"];
}

const { team } = Astro.props;
---

<section class="team-wrap wrap">
  <div class="section-dark">
    <p class="section-title center on-dark"><RichText text={team.title} /></p>

    <div class="team-panel">
      <ul class="team-grid" aria-label="Team">
        {
          team.members.map((id) => (
            <li class="team-card">
              <img
                class="avatar-photo"
                src={TEAM[id].photo}
                alt={TEAM[id].name}
                width="200"
                height="200"
                loading="lazy"
              />
              <span class="team-name">{TEAM[id].name}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="story-grid">
      <div class="story-copy">
        <h3>{team.story.heading}</h3>
        <p>{team.story.body}</p>
      </div>
      <dl class="stats">
        {
          team.stats.map((stat) => (
            <div class="stat">
              <dt>{stat.value}</dt>
              <dd>{stat.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
