---
/**
 * The wordmark, used in the header and again in the footer.
 *
 * Two colours, not one: the mark and lettering follow `currentColor`, while the
 * glyph is knocked out of the mark and so has to carry the colour of whatever
 * the logo is sitting on. That one reads `--brand-knockout`, set per context in
 * global.css — white on the page, the dark surface over a dark band.
 *
 * The file this came from paints the lettering #1A1A1A and the glyph white,
 * which is exactly what those two resolve to on a light page. Taking the
 * literals instead would look identical here and leave the logo dark-on-dark
 * in the footer and over every dark band, so the wiring stays.
 */
interface Props {
  href?: string;
}

const { href = "#top" } = Astro.props;
---

